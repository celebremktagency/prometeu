--
-- Name: workout_templates workout_templates_select; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY workout_templates_select ON public.workout_templates FOR SELECT USING (((is_public = true) OR (created_by = auth.uid())));


--
-- Name: workout_templates workout_templates_update; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY workout_templates_update ON public.workout_templates FOR UPDATE USING ((created_by = auth.uid()));


